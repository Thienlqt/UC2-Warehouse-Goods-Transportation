<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unity_slam_example</name>
  <version>0.0.1</version>
  <description>Unity Robotics SLAM + navigation example (ROS 1 Noetic)</description>
  <maintainer email="lamquangthien.lqt@gmail.com">Thienlqt</maintainer>
  <license>Apache 2.0</license>
  <author>Unity Robotics (original ROS 2 package in Robotics-Nav2-SLAM-Example)</author>

  <buildtool_depend>catkin</buildtool_depend>
  <test_depend>python3-pytest</test_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>ros_tcp_endpoint</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>uc2_vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
</package>
